@startuml
skinparam classAttributeIconSize 0

abstract class PlayerState {
    # stateName : string
    + {abstract} play(player : AudioPlayer&) : void
    + {abstract} pause(player : AudioPlayer&) : void
    + {abstract} stop(player : AudioPlayer&) : void
    + getName() : const string&
    # PlayerState(name : string)
}

note right of PlayerState
  Default play / pause / stop print
  "Invalid transition from <state> to <op>".
  Concrete subclasses override
  only the *valid* transitions.
end note

class AudioPlayer {
    - state : unique_ptr<PlayerState>
    + AudioPlayer()
    + setState(newState : unique_ptr<PlayerState>) : void
    + play() : void
    + pause() : void
    + stop() : void
    + currentState() : const string&
}

class StopMode {
    + StopMode()
    + play(player : AudioPlayer&) : void
}

class PlayMode {
    + PlayMode()
    + pause(player : AudioPlayer&) : void
    + stop(player : AudioPlayer&) : void
}

class PauseMode {
    + PauseMode()
    + play(player : AudioPlayer&) : void
}

StopMode  --|> PlayerState
PlayMode  --|> PlayerState
PauseMode --|> PlayerState

AudioPlayer *--> PlayerState : owns (unique_ptr)
@enduml
